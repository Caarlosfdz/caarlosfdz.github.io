---
import Base from '../layouts/Base.astro';
import Smoke from '../components/Smoke.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Página no encontrada | Carlos Fernández" description="Esta página no existe. Vuelve al inicio o mira los proyectos." noindex>
  <main id="contenido" class="e404 section section--dark">
    <div class="section__bg" aria-hidden="true">
      <Smoke uid="e404" />
      <span class="glow"></span>
      <span class="vignette"></span>
      <span class="grain"></span>
    </div>
    <span class="num display" aria-hidden="true">404</span>
    <div class="wrap in">
      <p class="hand" aria-hidden="true">vaya, aquí no hay nada</p>
      <h1 class="h2">Esta página no existe.</h1>
      <p class="sub">Puede que el enlace esté mal escrito o que el proyecto ya no esté. Vuelve al inicio o echa un vistazo a lo que he hecho.</p>
      <div class="btns">
        <a class="btn" href="/" data-magnetic>Volver al inicio</a>
        <a class="btn btn--ghost" href="/#proyectos">Ver proyectos</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .e404 { min-height: 100svh; display: grid; align-items: center; padding-top: 7rem; }
  .glow { position: absolute; width: 70vmax; aspect-ratio: 1; right: -25vmax; top: -10vmax; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 34%, transparent), transparent 70%); }
  .vignette { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 70% at 50% 45%, transparent 40%, rgb(0 0 0 / 0.75)); }
  .num { position: absolute; z-index: -1; right: -0.04em; bottom: -0.1em; font-size: clamp(14rem, 8rem + 36vw, 48rem); line-height: 0.8; letter-spacing: -0.06em; user-select: none;
    color: transparent; -webkit-text-stroke: 2.5px rgb(255 255 255 / 0.3); background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.01) 75%); -webkit-background-clip: text; background-clip: text; }
  .in { display: grid; gap: var(--space-3); justify-items: start; }
  .sub { max-width: 30rem; font-size: var(--step-1); line-height: 1.35; color: rgb(236 233 228 / 0.88); }
  .btns { display: flex; flex-wrap: wrap; gap: var(--space-2); }
</style>
