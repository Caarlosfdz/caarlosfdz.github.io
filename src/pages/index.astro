---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import About from '../components/About.astro';
import Bridge from '../components/Bridge.astro';
import Projects from '../components/Projects.astro';
import Servicios from '../components/Servicios.astro';
import Trayectoria from '../components/Trayectoria.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Carlos Fernández | Diseño web, logotipos y redes sociales en Cádiz y alrededores"
  description="Soy Carlos, estudiante de Marketing y Publicidad en Cádiz. Diseño webs, logotipos e identidad y gestiono redes sociales para negocios de Cádiz y alrededores."
>
  <main id="contenido">
    <Hero />
    <Marquee />
    <About />
    <Bridge />
    <Projects />
    <Servicios />
    <Trayectoria />
    <Contacto />
  </main>
  <Footer />
</Base>
