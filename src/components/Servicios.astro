---
import Smoke from './Smoke.astro';
import { siAstro, siGreensock, siGooglesheets, siGoogleappsscript } from 'simple-icons';

const servicios = [
  { nombre: 'Diseño web', texto: 'Webs claras, rápidas y pensadas para que quien llegue te escriba. Desde una página con scroll hasta una web con varias secciones.', para: 'Hostelería, salud y bienestar, belleza y estética' },
  { nombre: 'Logotipos e identidad', texto: 'Un logo y un estilo que se reconozcan igual en tu escaparate, en tu carta y en tus redes.', para: 'Negocios que empiezan o quieren renovar su imagen' },
  { nombre: 'Gestión de redes sociales', texto: 'Publicaciones con un estilo coherente y un calendario que se cumple, para que tú te dediques a tu negocio.', para: 'Negocios locales de la provincia de Cádiz' },
];
const pasos = [
  { t: 'Hablamos', d: 'Me cuentas qué hace tu negocio y qué necesitas. Sin compromiso.' },
  { t: 'Te propongo', d: 'Te explico qué haría yo y cómo, con palabras normales.' },
  { t: 'Lo hago', d: 'Diseño y desarrollo, y te enseño el avance para que opines.' },
  { t: 'Lo publicamos', d: 'Lo dejo funcionando y te explico cómo tocarlo tú.' },
];
const tools = [siAstro, siGreensock, siGooglesheets, siGoogleappsscript];
---
<section class="servicios section section--dark" id="servicios" aria-labelledby="serv-h">
  <div class="section__bg" aria-hidden="true"><Smoke uid="serv" /><span class="glow glow--a"></span><span class="glow glow--b"></span><span class="vignette"></span><span class="grain"></span></div>

  <div class="wrap">
    <p class="serv__pre">Diseño para negocios que quieren que se les vea</p>
    <h2 class="h2" id="serv-h" data-lines><span class="line"><span class="line__in">Qué hago.</span></span></h2>

    <ul class="rows panel">
      {servicios.map((s) => (
        <li class="row" data-row>
          <span class="row__fill" aria-hidden="true"></span>
          <h3 class="row__name display">{s.nombre}</h3>
          <p class="row__text">{s.texto}</p>
          <p class="row__para"><strong>Para</strong> {s.para}</p>
        </li>
      ))}
    </ul>

    <div class="proceso">
      <h3 class="h3" data-lines><span class="line"><span class="line__in">Cómo trabajo</span></span></h3>
      <p class="proceso__nota">[REVISAR] Pasos de ejemplo: ajústalos a tu forma real de trabajar.</p>
      <div class="pasos-wrap">
      <svg class="pasos__line" viewBox="0 0 1000 12" preserveAspectRatio="none" aria-hidden="true"><path data-draw d="M0 6H1000" /></svg>
      <ol class="pasos" data-steps>
        {pasos.map((p, i) => (
          <li class="paso">
            <span class="paso__n display">{i + 1}</span>
            <h4>{p.t}</h4>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
      </div>
    </div>

    <div class="tools">
      <h3 class="h3" data-lines><span class="line"><span class="line__in">Con qué lo hago</span></span></h3>
      <ul class="tools__list">
        {tools.map((t) => (
          <li class="tool" title={t.title}>
            <svg viewBox="0 0 24 24" role="img" aria-label={t.title}><path d={t.path} fill="currentColor" /></svg>
          </li>
        ))}
      </ul>
      <p class="hand tools__hand" aria-hidden="true">[REVISAR] aquí van tus herramientas de diseño</p>
    </div>
  </div>
</section>

<style>
  .vignette { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 70% at 50% 40%, transparent 45%, rgb(0 0 0 / 0.7)); }
  .glow { position: absolute; border-radius: 50%; }
  .glow--a { width: 60vw; aspect-ratio: 1; left: -25vw; top: 10%; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%); }
  .glow--b { width: 50vw; aspect-ratio: 1; right: -20vw; bottom: 4%; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%); }
  .serv__pre { font-size: var(--step-1); font-weight: 300; color: rgb(236 233 228 / 0.85); margin-bottom: 0.4rem; }
  .panel { border-radius: 1.5rem; padding: 0 clamp(1rem, 3vw, 2.5rem); background: linear-gradient(160deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.01));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12), 0 40px 80px -40px rgb(0 0 0 / 0.8); backdrop-filter: blur(4px); }
  .rows { margin: var(--space-5) 0 var(--space-6); }
  .row:last-child { border-bottom: 0; }
  .row {
    position: relative; isolation: isolate; overflow: hidden; display: grid; gap: var(--space-2);
    padding: var(--space-4) 0; border-bottom: 1px solid rgb(255 255 255 / 0.1); transition: color 0.35s;
  }
  .row__fill { position: absolute; inset: 0; z-index: -1; background: var(--accent); transform: scaleY(0); transform-origin: bottom; transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .row__name { font-size: clamp(1.5rem, 0.9rem + 2vw, 2.5rem); padding-inline: 0.5rem; }
  .row__text, .row__para { padding-inline: 0.5rem; max-width: 34rem; }
  .row__para { font-size: var(--step--1); color: rgb(236 233 228 / 0.65); transition: color 0.35s; }
  .row__para strong { color: var(--accent); transition: color 0.35s; }
  @media (hover: hover) {
    .row:hover { color: var(--on-accent); }
    .row:hover .row__fill { transform: scaleY(1); }
    .row:hover .row__para, .row:hover .row__para strong { color: var(--on-accent); }
  }
  @media (min-width: 52rem) {
    .row { grid-template-columns: 1.3fr 1.1fr 0.8fr; align-items: center; gap: var(--space-4); }
  }

  .h3 { font-family: var(--font-display); font-weight: 900; font-stretch: 118%; font-size: var(--step-3); line-height: 1; letter-spacing: -0.02em; }
  .proceso__nota { margin-top: var(--space-1); font-size: var(--step--1); color: var(--accent); }
  .pasos-wrap { position: relative; }
  .pasos { position: relative; display: grid; gap: var(--space-4); margin: 0; padding: 0; counter-reset: p; }
  .pasos-wrap { margin: var(--space-4) 0 var(--space-6); }
  .pasos__line { display: none; }
  .paso { position: relative; padding: var(--space-3); border-radius: 1.25rem; background: linear-gradient(160deg, #19191c, #0f0f11);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08); }
  .paso__n { display: grid; place-items: center; width: 3rem; aspect-ratio: 1; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 1.4rem; margin-bottom: var(--space-2); }
  .paso h4 { margin: 0 0 0.4rem; font-family: var(--font-display); font-stretch: 112%; font-size: var(--step-1); }
  .paso p { color: rgb(236 233 228 / 0.75); font-size: var(--step--1); }
  @media (min-width: 52rem) {
    .pasos { grid-template-columns: repeat(4, 1fr); padding-top: 1.5rem; }
    .pasos__line { display: block; position: absolute; left: 0; right: 0; top: 0.9rem; width: 100%; height: 12px; z-index: 0; }
    .pasos__line path { stroke: var(--accent); stroke-width: 2; stroke-dasharray: 6 8; vector-effect: non-scaling-stroke; fill: none; }
  }

  .tools__list { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-3); }
  .tool { display: grid; place-items: center; width: 4.5rem; aspect-ratio: 1; border-radius: 1.1rem; background: linear-gradient(160deg, #1c1c1f, #101012);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.09); color: var(--cal); transition: color 0.3s, transform 0.3s; }
  .tool:hover { color: var(--accent); transform: translateY(-4px) rotate(-4deg); }
  .tool svg { width: 2rem; height: 2rem; }
  .tools__hand { margin-top: var(--space-2); font-size: 1.4rem; }
</style>
