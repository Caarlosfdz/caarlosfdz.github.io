---
import { Image } from 'astro:assets';
import retrato from '../assets/carlos-recorte.png';
import rim from '../assets/carlos-rim.png';
import Smoke from './Smoke.astro';
import { enlacePrincipal } from '../config/contacto';

---
<section class="hero" id="inicio" aria-labelledby="hero-titulo">
  <div class="hero__bg" aria-hidden="true">
    <Smoke />
    <span class="vignette"></span>
    <span class="grain"></span>
  </div>

  <h1 class="hero__title display" id="hero-titulo">
    <span class="line"><span class="line__in">Hola, soy</span></span>
    <span class="line line--name"><span class="line__in">Carlos Fernández</span></span>
  </h1>

  <div class="hero__foot">
    <a class="btn" href={enlacePrincipal} data-magnetic>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.4 7.5L3 21l1.600-5.400A8.500 8.500 0 1 1 21 12Z"/></svg>
      Escríbeme por WhatsApp
    </a>
  </div>

  <div class="hero__stage">
    <div class="hero__word display" aria-hidden="true" data-depth="-1">PORTFOLIO</div>

    <div class="hero__portrait">
      <span class="hero__halo" aria-hidden="true"></span>
      <span class="hero__circle" aria-hidden="true" data-depth="0.6"></span>
      <div class="hero__figure" data-depth="1">
        <Image
          src={retrato}
          alt="Retrato de Carlos Fernández en blanco y negro"
          widths={[360, 540, 720, 960]}
          sizes="(min-width: 52rem) 46vw, min(100vw, 460px)"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <!-- Reflejo lima en los hombros: capa ya pintada, sin máscaras ni mezclas en vivo -->
        <Image class="hero__rim" src={rim} alt="" widths={[360, 540, 720]} sizes="(min-width: 52rem) 46vw, min(100vw, 460px)" format="webp" loading="eager" aria-hidden="true" />
      </div>
    </div>

  <ul class="pills" aria-label="Servicios">
      <li class="pill pill--1">
        <span class="pill__in" data-pill>
          <span class="pill__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.500" width="18" height="15" rx="2.500"/><path d="M3 9.500h18"/><circle cx="6.500" cy="7" r=".4"/></svg></span>
          Diseño web
        </span>
      </li>
      <li class="pill pill--2">
        <span class="pill__in" data-pill>
          <span class="pill__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.500 18.500 11 12 21.500 5.500 11Z"/><circle cx="12" cy="11" r="1.700"/></svg></span>
          Logotipos e identidad
        </span>
      </li>
      <li class="pill pill--3">
        <span class="pill__in" data-pill>
          <span class="pill__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.500s-8-4.800-8-10.700A4.600 4.600 0 0 1 12 7a4.600 4.600 0 0 1 8 2.800c0 5.900-8 10.700-8 10.700Z"/></svg></span>
          Redes sociales
        </span>
      </li>
    </ul>
  </div>


  <p class="hero__note hand" aria-hidden="true">
    <svg class="arrow" viewBox="0 0 120 70" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path class="arrow__path" d="M112 8C86 4 52 12 40 44c-2 6-3 12-2 18"/><path class="arrow__path" d="M26 50l12 14 14-12"/></svg>
    ¿Tienes un negocio por aquí? Cuéntamelo.
  </p>

  <div class="scroll" aria-hidden="true"><span>Baja</span><i></i></div>
</section>

<style>
  .hero {
    --pw: min(100vw, 460px);
    --ph: calc(var(--pw) * 1.05);
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 100svh;
    display: flex; flex-direction: column;
    padding-top: 5.25rem;
    background: var(--noche);
  }

  /* ---------- Fondo: humo, viñeta y grano ---------- */
  .hero__bg { position: absolute; inset: 0; z-index: -1; }
  .vignette {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 75% 65% at 50% 55%, transparent 40%, rgb(0 0 0 / 0.78) 100%),
      radial-gradient(ellipse 60% 40% at 50% 100%, rgb(0 0 0 / 0.5), transparent);
  }
  /* Fundido a negro abajo en vez de corte */
  .hero::after {
    content: ''; position: absolute; inset: auto 0 0 0; height: 24%; z-index: 3; pointer-events: none;
    background: linear-gradient(to top, var(--noche) 4%, rgb(11 11 12 / 0.7) 40%, transparent);
  }

  /* ---------- Titular ---------- */
  .hero__title {
    position: relative; z-index: 6; padding: 0 var(--gutter); text-align: center;
    font-size: 12vw;
  }
  .line { display: block; overflow: hidden; padding-block: 0.06em; }
  .line__in { display: block; }
  .line--name { color: var(--accent); }

  /* ---------- Pie: texto y botón ---------- */
  .hero__foot {
    position: relative; z-index: 6; padding: var(--space-3) var(--gutter) 0;
    display: flex; flex-direction: column; gap: var(--space-2); align-items: flex-start;
  }
  .btn { white-space: nowrap; }

  /* ---------- Escenario: capas ---------- */
  .hero__stage { position: relative; flex: 1; min-height: calc(var(--ph) + 2.5rem); }

  .hero__word {
    position: absolute; z-index: 0; left: 0; right: 0; bottom: calc(var(--ph) * 0.7);
    text-align: center; white-space: nowrap; user-select: none;
    font-stretch: 62%; font-size: 21vw; line-height: 0.8; letter-spacing: -0.02em;
    color: transparent;
    background: linear-gradient(to bottom, #6a6a72 0%, #3a3a40 55%, #1b1b1f 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.2);
  }

  .hero__portrait {
    position: absolute; z-index: 2; bottom: 0; left: 0; right: 0; margin-inline: auto;
    width: var(--pw); isolation: isolate;
  }
  .hero__figure { position: relative; }
  .hero__figure :global(img) { display: block; width: 100%; height: auto; }
  .hero__figure :global(.hero__rim) { position: absolute; inset: 0; pointer-events: none; }
  .hero__halo {
    position: absolute; z-index: -3; left: 50%; bottom: -10%; width: 160%; aspect-ratio: 1;
    margin-left: -80%; border-radius: 50%; opacity: 0.5;
    background: radial-gradient(closest-side, var(--accent), transparent 70%);
  }
  .hero__circle {
    position: absolute; z-index: -1; left: 50%; bottom: -14%;
    width: 106%; aspect-ratio: 1; margin-left: -53%; border-radius: 50%; overflow: hidden;
    background:
      radial-gradient(circle at 50% 24%, var(--accent-hi) 0%, var(--accent) 34%, var(--accent-lo) 100%);
    box-shadow: 0 0 80px 8px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .hero__circle::before { /* grano horneado, más suave que el sombreado */
    content: ''; position: absolute; inset: 0; background: url('/grain-dark.png') 0 0 / 128px 128px; opacity: 0.4;
  }
  .hero__circle::after { /* sombra inferior */
    content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / 0.5), transparent 55%);
  }

  /* ---------- Pastillas ---------- */
  .pills { position: absolute; inset: 0; z-index: 4; pointer-events: none; }
  .pill { position: absolute; }
  .pill__in {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.4rem 1rem 0.4rem 0.4rem; border-radius: var(--radius);
    background: var(--cal); color: var(--tinta); white-space: nowrap;
    font-family: var(--font-display); font-stretch: 105%; font-weight: 750;
    font-size: 0.8rem; line-height: 1;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 14px 30px rgb(0 0 0 / 0.5), 0 3px 8px rgb(0 0 0 / 0.35);
  }
  .pill__icon {
    display: grid; place-items: center; flex: none;
    width: 1.9rem; aspect-ratio: 1; border-radius: 50%;
    background: var(--noche); color: var(--accent);
  }
  .pill__icon svg { width: 55%; height: 55%; }
  .pill--1 { left: 2%; bottom: calc(var(--ph) * 0.36); rotate: -6deg; }
  .pill--2 { right: 2%; bottom: calc(var(--ph) * 0.23); rotate: 5deg; }
  .pill--3 { left: 9%; bottom: calc(var(--ph) * 0.1); rotate: -3deg; }

  /* ---------- Detalles laterales (solo escritorio) ---------- */
  .hero__note, .scroll { display: none; }
  .hand { font-family: var(--font-hand); font-size: 1.7rem; line-height: 1.1; color: var(--accent); }

  @media (max-width: 51.99rem) {
    .hero__title { margin-top: 0.5rem; }
    .hero__word { bottom: calc(var(--ph) * 0.86); }
    .hero__foot { padding-bottom: var(--space-2); }
  }

  /* ---------- Escritorio ---------- */
  @media (min-width: 52rem) {
    .hero {
      --pw: min(46vw, calc((100svh - 13.5rem) * 0.95));
      display: block; padding-top: 0;
    }
    .hero__title { position: absolute; top: 5.2rem; left: 0; right: 0; font-size: clamp(2.4rem, 1rem + 3.9vw, 4.6rem); }
    .hero__stage { position: absolute; inset: 0; min-height: 0; }
    .hero__foot { position: absolute; left: var(--gutter); bottom: 2.75rem; padding: 0; }

    .hero__word { bottom: calc(var(--ph) * 0.64); font-size: 19.5vw; }

    .pill__in { gap: 0.75rem; padding: 0.55rem 1.5rem 0.55rem 0.55rem; font-size: var(--step-0); }
    .pill__icon { width: 2.7rem; }
    .pill--1 { left: calc(50% - var(--pw) * 0.86); bottom: calc(var(--ph) * 0.6); rotate: -7deg; }
    .pill--2 { right: calc(50% - var(--pw) * 0.9); left: auto; bottom: calc(var(--ph) * 0.7); rotate: 5deg; }
    .pill--3 { left: calc(50% + var(--pw) * 0.1); bottom: calc(var(--ph) * 0.16); rotate: -4deg; }

    .hero__note {
      display: block; position: absolute; z-index: 6; right: var(--gutter); bottom: 2.75rem;
      width: 17rem; font-size: 2rem;
    }
    .arrow { position: absolute; width: 5.5rem; left: -5rem; top: -3.5rem; transform: scaleX(-1); }

    .scroll {
      display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
      position: absolute; z-index: 6; left: 50%; bottom: 0.9rem; translate: -50% 0;
      font-size: 0.78rem; letter-spacing: 0.04em; color: rgb(236 233 228 / 0.75);
    }
    .scroll i { width: 1px; height: 2.2rem; background: rgb(236 233 228 / 0.25); overflow: hidden; position: relative; }
    .scroll i::after { content: ''; position: absolute; inset: 0; background: var(--accent); animation: drip 2.2s ease-in-out infinite; }
    @keyframes drip { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(100%); } }
  }
</style>
