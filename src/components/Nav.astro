---
import { enlacePrincipal } from '../config/contacto';
---
<header class="nav" data-nav>
  <a class="nav__logo" href="/" aria-label="Carlos Fernández, inicio">Carlos Fernández</a>
  <nav aria-label="Principal">
    <ul class="nav__links">
      <li><a href="#proyectos">Proyectos</a></li>
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#sobre-mi">Sobre mí</a></li>
      <li><a href="#trayectoria">Trayectoria</a></li>
    </ul>
  </nav>
  <a class="nav__cta" href={enlacePrincipal} data-magnetic>Hablemos</a>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    background: rgb(11 11 12 / 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), background 0.3s, backdrop-filter 0.3s;
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    padding: 1rem var(--gutter);
  }
  :global(.nav--top) { background: transparent !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }
  :global(.nav--hidden) { transform: translateY(-110%); }
  .nav__logo {
    font-family: var(--font-display); font-stretch: 112%; font-weight: 800;
    text-decoration: none; font-size: var(--step-0); letter-spacing: -0.01em;
  }
  .nav__links { display: none; gap: var(--space-4); }
  .nav__links a { text-decoration: none; font-weight: 500; opacity: 0.8; transition: opacity 0.2s; }
  .nav__links a:hover { opacity: 1; }
  .nav__cta {
    padding: 0.7rem 1.2rem; border-radius: var(--radius);
    border: 1.5px solid var(--cal); text-decoration: none; font-weight: 600;
    font-size: var(--step--1); transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .nav__cta:hover { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  @media (min-width: 52rem) { .nav__links { display: flex; } }
</style>
