---
// Humo fluido: cintas de seda ya difuminadas (imágenes WebP de pocos KB) que derivan despacio.
// Sin filtros SVG en tiempo real: el desenfoque está horneado, así que no cuesta nada de render.
import a from '../assets/smoke/ribbon-a-dark.webp';
import b from '../assets/smoke/ribbon-b-dark.webp';
import aL from '../assets/smoke/ribbon-a-light.webp';
import bL from '../assets/smoke/ribbon-b-light.webp';
interface Props { tone?: 'dark' | 'light'; uid?: string; still?: boolean; }
const { tone = 'dark', still = false } = Astro.props;
const [ra, rb] = tone === 'light' ? [aL, bL] : [a, b];
---
<div class:list={['smoke', { 'smoke--still': still }]} aria-hidden="true">
  <img class="ribbon ribbon--a" src={ra.src} width={ra.width} height={ra.height} alt="" decoding="async" loading="lazy" />
  <img class="ribbon ribbon--b" src={rb.src} width={rb.width} height={rb.height} alt="" decoding="async" loading="lazy" />
  <span class="lime"></span>
</div>

<style>
  .smoke { position: absolute; inset: 0; overflow: hidden; }
  /* Sin deriva en secciones muy largas y cargadas (proyectos): el humo queda quieto y no cuesta nada al hacer scroll */
  .smoke--still .ribbon, .smoke--still .lime { animation: none; }
  .ribbon { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .smoke[data-off] .ribbon, .smoke[data-off] .lime { animation-play-state: paused; }
  .ribbon--a { animation: sway-a 24s ease-in-out infinite alternate; }
  .ribbon--b { animation: sway-b 30s ease-in-out infinite alternate; }
  .lime {
    position: absolute; left: 10%; right: 5%; bottom: -12%; height: 38%; rotate: -8deg;
    background: radial-gradient(ellipse 50% 50% at 50% 50%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%);
    animation: sway-a 36s ease-in-out infinite alternate-reverse;
  }
  @keyframes sway-a { to { transform: translate3d(40px, -24px, 0); } }
  @keyframes sway-b { to { transform: translate3d(-46px, 20px, 0); } }
</style>
