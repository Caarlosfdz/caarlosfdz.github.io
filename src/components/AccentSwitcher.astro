---
// TEMPORAL (fase 1): selector para comparar los tres acentos. Se borra al elegir.
---
<div class="sw" role="group" aria-label="Probar color de acento (temporal)">
  <a href="?" data-v="">Lima</a>
  <a href="?acento=cobalto" data-v="cobalto">Cobalto</a>
  <a href="?acento=bermellon" data-v="bermellon">Bermellón</a>
</div>
<style>
  .sw { position: fixed; z-index: 90; bottom: 1rem; right: 1rem; display: flex; gap: 0.25rem;
    padding: 0.3rem; background: rgb(11 11 12 / 0.85); border: 1px solid #333; border-radius: 999px;
    backdrop-filter: blur(6px); font-size: 0.8rem; }
  .sw a { padding: 0.35rem 0.8rem; border-radius: 999px; text-decoration: none; }
  .sw a[aria-current='true'] { background: var(--accent); color: var(--on-accent); }
</style>
<script>
  const cur = document.documentElement.dataset.accent ?? '';
  document.querySelectorAll<HTMLAnchorElement>('.sw a').forEach((a) => {
    if (a.dataset.v === cur) a.setAttribute('aria-current', 'true');
  });
</script>
