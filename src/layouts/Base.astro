---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Intro from '../components/Intro.astro';
import Nav from '../components/Nav.astro';
import archivoWoff2 from '../assets/fonts/archivo-latin-wdth-normal.woff2?url';
import instrumentWoff2 from '../assets/fonts/instrument-sans-latin-wght-normal.woff2?url';

interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const og = new URL('/og.jpg', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={archivoWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentWoff2} crossorigin />
    <meta name="theme-color" content="#0B0B0C" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Carlos Fernández" />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Carlos Fernández, diseño web, logotipos y redes sociales en Cádiz y alrededores" />
    <meta name="twitter:image" content={og} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (!sessionStorage.getItem('intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('intro-on');
          sessionStorage.setItem('intro', '1');
          setTimeout(function () { document.documentElement.classList.remove('intro-on'); }, 3500);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Intro />
    <Nav />
    <slot />
    <div class="cursor" aria-hidden="true"><span></span></div>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  .cursor { display: none; }
  @media (hover: hover) and (pointer: fine) and (min-width: 52rem) {
    .cursor {
      display: grid; place-items: center; position: fixed; z-index: 150; left: 0; top: 0; width: 6.5rem; aspect-ratio: 1;
      margin: -3.25rem 0 0 -3.25rem; border-radius: 50%; background: var(--accent); color: var(--on-accent); pointer-events: none;
      font-family: var(--font-display); font-stretch: 112%; font-weight: 800; font-size: 0.85rem; text-align: center; line-height: 1.1;
      transform: scale(0); will-change: transform;
    }
  }
</style>
